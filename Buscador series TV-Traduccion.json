      ],
      "id": "9551f330-eaf8-4b7b-a9b9-794c847dfb3b",
      "name": "Dividir resumen"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d88c4b7f-b654-4a26-8966-c33595dad0d2",
              "name": "chuckIndex",
              "value": "={{ $('Dividir resumen').item.json.chunkIndex }}",
              "type": "number"
            },
            {
              "id": "16c232a5-c966-43b7-9e7c-4acdc4fbf91f",
              "name": "=translation",
              "value": "={{ $json.matches[0].translation }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
