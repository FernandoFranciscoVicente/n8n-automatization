      "id": "3f744c3d-7bea-4021-9c3a-b6d6257bdfb1",
      "name": "Preparar traducción"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nitems.sort((a, b) => {\n  return a.json.chunkIndex - b.json.chunkIndex;\n});\n\nconst summary = items\n  .map(item => item.json.translation)\n  .join(' ');\n\nreturn [\n  {\n    json: {\n      summary\n    }\n  }\n];"
      },
